raw `LittlerootClearing_MapScripts::
	.byte 0
`

script LittlerootClearing_EventScript_May {
    switch(var(VAR_LITTLEROOT_INTRO_STATE)){
        case 3: call(LittlerootClearing_EventScript_NoEgg)
        case 4: call(LittlerootClearing_EventScript_MayNoDex)
        case 5: call(LittlerootClearing_EventScript_LookingForAsst)
    }
}

script LittlerootClearing_EventScript_NoEgg {
    lock
    faceplayer
    setspeaker("Birch")
    msgbox(format("Hi there! I'm going to be in the clearing all day, but my dad should be coming by any time now..."))
    applymovement(LOCALID_LITTLEROOTGROTTO_PROFMAY, moves(
        face_up
    ))
    waitmovement(0)
    release
}

script LittlerootClearing_EventScript_MayNoDex {
    lock
    faceplayer
    setspeaker("Birch")
    msgbox(format("Hi {PLAYER}! Wow, a Togepi! Did my dad give you that egg to pass to me?"))
    applymovement(LOCALID_LITTLEROOTGROTTO_PROFMAY, moves(
        emote_heart
    ))
    delay(32)
    msgbox(format("It seems to have taken a liking to you! Why don't you hold onto it, as your very first POKéMON!"))
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    msgbox("What am I doing here?")
    applymovement(LOCALID_LITTLEROOTGROTTO_PROFMAY, moves(
        face_up
    ))
    msgbox(format("I'm studying the trees, of course! I'm scheduled to be here all day. But I think my assistant has my field book..."))
    faceplayer
    msgbox(format("I hate to ask you, {PLAYER}, but could you go find them on Route 103?"))
    applymovement(LOCALID_LITTLEROOTGROTTO_PROFMAY, moves(
        face_up
    ))
    waitmovement(0)
    setflag(FLAG_TALKED_TO_PROF)
    setvar(VAR_ROUTE101_STATE, 3)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 2)
    setvar(VAR_LITTLEROOT_INTRO_STATE, 5)
    release
}

script LittlerootClearing_EventScript_LookingForAsst {
    lock
    faceplayer
    setspeaker("Birch")
    msgbox(format("I found my Munchie in a tree kinda like this..."))
    applymovement(LOCALID_LITTLEROOTGROTTO_PROFMAY, moves(
        face_up
    ))
    waitmovement(0)
    release
}