raw`
`
mapscripts LittlerootTown_PlayerHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        switch(var(VAR_LITTLEROOT_INTRO_STATE)){
            case 1: call(LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToStairs)
            case 2: call(LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToIsland)
            case 3: call(LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToIsland)
            case 4: call(LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToIsland)
            case 5: call(LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToIsland)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: LittlerootTown_PlayerHouse_1F_OnFrame
    ]
}

script LittlerootTown_PlayerHouse_1F_OnFrame {
    switch(var(VAR_LITTLEROOT_INTRO_STATE)){
        case 1: call(LittlerootTown_PlayerHouse_1F_EventScript_GoUpstairsToSetClock)
        case 2: call(LittlerootTown_PlayerHouse_1F_EventScript_PreParty)
        case 6: call(LittlerootTown_PlayerHouse_1F_EventScript_Party)
    }
}

script LittlerootTown_PlayerHouse_1F_EventScript_GoUpstairsToSetClock {
    lockall
    call(LittlerootTown_PlayerHouse_1F_EventScript_GoSetTheClock)
    applymovement(LOCALID_PLAYER, moves(
        walk_up
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, moves(
        walk_up))
    waitmovement(0)
    warp(MAP_LITTLEROOT_TOWN_PLAYER_HOUSE_2F, 7, 1)
    waitstate
    releaseall
}

script LittlerootTown_PlayerHouse_1F_EventScript_GoSetTheClock {
    setspeaker(SP_NAME_MOM)
    msgbox(format("{PLAYER}, make sure you set the clock we got you, honey."))
}

script LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToStairs {
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_MOM, 8, 4)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP)
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_DAD, 1, 3)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_DAD, MOVEMENT_TYPE_FACE_UP)
}

script LittlerootTown_PlayerHouse_1F_EventScript_MoveMomToIsland {
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_MOM, 3, 5)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP)
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_DAD, 1, 3)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_DAD, MOVEMENT_TYPE_FACE_UP)
}

script LittlerootTown_PlayerHouse_1F_EventScript_PreParty {
    lockall
    setvar(VAR_0x8004, LOCALID_PLAYERS_HOUSE_1F_MOM)
    setvar(VAR_0x8005, LOCALID_PLAYERS_HOUSE_1F_DAD)
    playse(SE_PIN)
    applymovement(VAR_0x8005, moves(
        face_right
        emote_exclamation_mark))
    waitmovement(0)
    setspeaker("Dad")
    msgbox(format("{PLAYER}, happy birthday!"))
    applymovement(LOCALID_PLAYER, moves(
        walk_left * 6
    ))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(VAR_0x8005, moves(
        emote_heart))
    waitmovement(0)
    applymovement(VAR_0x8004, moves(
        emote_heart))
    waitmovement(0)
    msgbox(format("We're still getting everything ready here. But isn't it so exciting? You're old enough to enter the leagues now!"))
    applymovement(LOCALID_PLAYER, moves(
        face_down
    ))
    waitmovement(0)
    applymovement(VAR_0x8004, moves(
        walk_left
        face_up
    ))
    waitmovement(0)
    setspeaker("Mom")
    msgbox(format("It seems like just yesterday you were knee-high, dressed up as Wallace, talking about being champion. All kids leave home someday..."))
    applymovement(VAR_0x8004, moves(
        jump_in_place_up
    ))
    waitmovement(0)
    msgbox(format("But you can't leave until we see you off!"))
    msgbox(format("Could you go next door and see if the Professor finished making the cake?"))
    setvar(VAR_TEMP_1, 1)
    setvar(VAR_LITTLEROOT_INTRO_STATE,3)
    setrespawn(HEAL_LOCATION_LITTLEROOT_TOWN_PLAYER_HOUSE_2F)
    releaseall
}

script LittlerootTown_PlayerHouse_1F_EventScript_Mom {
    lock
    faceplayer
    // call(LittlerootTown_PlayerHouse_1F_EventScript_DontPushYourselfTooHard)
    if(var(VAR_LITTLEROOT_INTRO_STATE) <= 6){
        
        goto(LittlerootTown_PlayerHouse_1F_EventScript_TalkToProf)
    }
    if(var(VAR_LITTLEROOT_INTRO_STATE) == 7){
        call(PlayersHouse_1F_EventScript_MomHealsParty)
    }
    setspeaker("Mom")
    msgbox(format("See, {PLAYER}?"))
    msgbox(format("Isn't it nice in here, too?"))
    release
}

script LittlerootTown_PlayerHouse_1F_EventScript_DontPushYourselfTooHard{
    setspeaker("Mom")
    msgbox(format("Don't push yourself too hard, dear."))
    msgbox("You can always come home.")
    msgbox("Go for it, honey!")
}

script LittlerootTown_PlayerHouse_1F_EventScript_Dad {
    lock
    faceplayer
    if(var(VAR_LITTLEROOT_INTRO_STATE) <= 6){
        goto(LittlerootTown_PlayerHouse_1F_EventScript_Steak)
    }
    setspeaker("Dad")
    msgbox(format("Remember to come home once in a while."))
    msgbox(format("Your mom and I are cheering for you every day!"))
    release
}

script LittlerootTown_PlayerHouse_1F_EventScript_TalkToProf {
    setspeaker("Mom")
    msgbox("Did you talk to the Professor?")
    release
}

script LittlerootTown_PlayerHouse_1F_EventScript_Steak {
    setspeaker("Dad")
    msgbox("This steak isn't going to make itself!")
    release
}

script LittlerootTown_PlayerHouse_1F_EventScript_Party {
    lock
    playse(SE_PIN)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, moves(
        face_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_DAD, moves(
        face_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_BIRCH, moves(
        face_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_RIVAL, moves(
        face_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    setspeaker("Everyone")
    msgbox(format("HAPPY BIRTHDAY, {PLAYER}!"))
    playfanfare(MUS_RG_DEX_RATING)
    waitfanfare
    setspeaker("Mom")
    msgbox(format("The Professor made you this Torchic cake! Come here and make a wish!"))
    applymovement(LOCALID_PLAYER, moves(
        walk_up * 3
        walk_left * 4
        face_down
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_PROF, moves(
        walk_left * 2
        walk_down * 2
        walk_right *2
        face_down
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, moves(
        delay_8
        face_right
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_DAD, moves(
        delay_8
        face_left
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_BIRCH, moves(
        delay_8
        face_right
    ))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_RIVAL, moves(
        delay_8
        face_left
    ))
    waitmovement(0)
    setspeaker("Prof Birch")
    msgbox(format("I had to get some natural syrup in the clearing for the flavor!"))
    setspeaker("Dad")
    msgbox(format("What's everyone waiting for? Let's dig in!"))
    fadescreen(FADE_TO_BLACK)
    playse(SE_M_EARTHQUAKE)
    waitse
    removeobject(LOCALID_PLAYERS_HOUSE_1F_CAKE)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_DEX, moves(
        slide_down * 2
    ))
    fadescreen(FADE_FROM_BLACK)
    setspeaker("Birch")
    msgbox(format("Delicious as always, May!"))
    setspeaker("Prof Birch")
    msgbox(format("Thanks dad! Now, {PLAYER}, time for the best part."))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_PROF, moves(
        jump_in_place_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYER, moves(
        face_left
    ))
    waitmovement(0)
    msgbox(format("It's gift time! Happy birthday! From my dad, {RIVAL}, and I, we want you to have a Pokédex! Think of it as a part 2 to the Togepi we gave you!"))
    call(LittlerootTown_PlayerHouse_1F_EventScript_ReceivePokedex)
    setspeaker("{RIVAL}")
    msgbox(format("Now you'll help advance our research while you go out and travel the region!"))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_BIRCH, moves(
        emote_heart
    ))
    waitmovement(0)
    setspeaker("Dad")
    msgbox(format("And now, from us! We know how much you've been talking about entering the leagues, so we got you something special!"))
    applymovement(LOCALID_PLAYER, moves(
        face_down
    ))
    waitmovement(0)
    call(LittlerootTown_PlayerHouse_1F_EventScript_ReceiveLicense)
    setspeaker("Mom")
    msgbox(format("Your dad and I will always be rooting for you, honey! Go show the world what you can do!"))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, moves(
        emote_heart
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_DAD, moves(
        emote_heart
    ))
    waitmovement(0)
    setspeaker("Dad")
    msgbox(format("Let's get this party started!"))
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, moves(
        jump_in_place_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_DAD, moves(
        jump_in_place_left
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_BIRCH, moves(
        jump_in_place_right
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_RIVAL, moves(
        jump_in_place_left
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYER, moves(
        jump_in_place_down
        emote_exclamation_mark
    ))
    waitmovement(0)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_PROF, moves(
        jump_in_place_down
        emote_exclamation_mark
    ))
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_LITTLEROOT_INTRO_STATE, 7)
    setvar(VAR_OLDALE_TOWN_STATE, 1)
    setflag(FLAG_PARTY_OVER)
    setflag(FLAG_ADVENTURE_STARTED)
    removeobject(LOCALID_PLAYERS_HOUSE_1F_BIRCH)
    removeobject(LOCALID_PLAYERS_HOUSE_1F_RIVAL)
    removeobject(LOCALID_PLAYERS_HOUSE_1F_PROF)
    warp(MAP_LITTLEROOT_TOWN_PLAYER_HOUSE_2F, 1, 4)
    fadescreen(FADE_FROM_BLACK)
    release
}

script LittlerootTown_PlayerHouse_1F_EventScript_ReceivePokedex {
    playfanfare(MUS_OBTAIN_ITEM)
    message(LittlerootTown_ProfessorBirchsLab_Text_ReceivedPokedex)
    waitfanfare
    removeobject(LOCALID_PLAYERS_HOUSE_1F_DEX)
    setflag(FLAG_SYS_POKEDEX_GET)
    special(SetUnlockedPokedexFlags)
    setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
    setvar(VAR_CABLE_CLUB_TUTORIAL_STATE, 1)
    return
}

script LittlerootTown_PlayerHouse_1F_EventScript_ReceiveLicense {
    playfanfare(MUS_OBTAIN_ITEM)
    setspeaker(NULL)
    msgbox(format("{PLAYER} received the Minor League License!"))
    waitfanfare
    return
}

