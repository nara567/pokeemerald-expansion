raw `
// SlateportCity_Gym_MapScripts::
// 	.byte 0
`

mapscripts SlateportCity_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_DEFEATED_RUSTBORO_GYM) == false) {
            clearflag(FLAG_DEFEATED_VOLTORB_1_NEW_MAUVILLE)
            clearflag(FLAG_DEFEATED_VOLTORB_2_NEW_MAUVILLE)
            clearflag(FLAG_DEFEATED_VOLTORB_3_NEW_MAUVILLE)
        }
    }
}

script SlateportCity_Gym_EventScript_Gulliver {
    lock
    if (flag(FLAG_DEFEATED_VOLTORB_1_NEW_MAUVILLE) && flag(FLAG_DEFEATED_VOLTORB_2_NEW_MAUVILLE) && flag(FLAG_DEFEATED_VOLTORB_3_NEW_MAUVILLE)){
        call(SlateportCity_Gym_EventScript_GulliverBattle)
    } elif (flag(FLAG_DEFEATED_RUSTBORO_GYM)){
        msgbox(SlateportCity_Gym_Text_GulliverPostBattle)
    } else {
        setspeaker("Gulliver")
        msgbox(format("Welcome {PLAYER}! You thought just because you made it to me, you'll get to battle? Ohoho, no!"))
        msgbox(format("You have to conquer the three castles in the gym before you can face me."))
    }
    release
}

script SlateportCity_Gym_EventScript_GulliverBattle {
    trainerbattle_single(TRAINER_GULLIVER_1, SlateportCity_Gym_Text_GulliverIntro, SlateportCity_Gym_Text_GulliverDefeat, RustboroCity_Gym_EventScript_GulliverDefeated, NO_MUSIC)
    msgbox(SlateportCity_Gym_Text_GulliverPostBattle)
}

text SlateportCity_Gym_Text_GulliverIntro {
    format("I'm Gulliver!")
}

 text SlateportCity_Gym_Text_GulliverDefeat {
    format("You got me!")
}

script RustboroCity_Gym_EventScript_GulliverDefeated {
    lock
    message(format("{PLAYER} received the Beach Badge from Gulliver."))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    msgbox(format("The Beach Badges lets you use whatever. Take this TM also."))
    setflag(FLAG_DEFEATED_RUSTBORO_GYM)
    setflag(FLAG_BADGE01_GET)
    setvar(VAR_0x8008,1)
    call(Common_EventScript_SetGymTrainers)
    giveitem(ITEM_TM_BULLDOZE)
    goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
    setflag(FLAG_RECEIVED_TM_BULLDOZE)
    msgbox(format("I also never properly thanked you for helping me out in the Museum! Take this as a token of my appreciation."))
    giveitem(ITEM_SS_TICKET)
    release
}

text SlateportCity_Gym_Text_GulliverPostBattle {
    format("Boo hoo.")
}

script SlateportCity_Gym_Eventscript_Sandygast_1 {
    lock
    faceplayer
    setwildbattle(SPECIES_SANDYGAST, 10)
    waitse
    playmoncry(SPECIES_SANDYGAST, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if(var(VAR_RESULT) == B_OUTCOME_WON){
        call(SlateportCity_Gym_EventScript_DefeatedSandygast1)
    } elif (var(VAR_RESULT) == B_OUTCOME_RAN){
        call(SlateportCity_Gym_EventScript_DefeatedSandygast1)
    } elif (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED){
        call(SlateportCity_Gym_EventScript_DefeatedSandygast1)
    }
    setflag(FLAG_DEFEATED_VOLTORB_1_NEW_MAUVILLE)
    release
}

script SlateportCity_Gym_EventScript_DefeatedSandygast1 {
    setflag(FLAG_DEFEATED_VOLTORB_1_NEW_MAUVILLE)
    goto(Common_EventScript_RemoveStaticPokemon)
}

