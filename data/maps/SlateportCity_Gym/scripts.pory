script SlateportCity_Gym_EventScript_Josh {
    //setspeaker("Josh")
    trainerbattle_single(TRAINER_JOSH, SlateportCity_Gym_Text_JoshIntro,SlateportCity_Gym_Text_JoshDefeat, SlateportCity_Gym_Text_JoshPostBattle, NO_MUSIC)
    setspeaker("Josh")
    msgbox(format("Good Luck!"))
    waitmessage
    release
}

text SlateportCity_Gym_Text_JoshIntro{
    format("Don't take us Gym Trainers lightly! I'll show you why we're better!")
}

text SlateportCity_Gym_Text_JoshDefeat{
    format("You were too good for me...")
}

script SlateportCity_Gym_Text_JoshPostBattle{
    setspeaker("Josh")
    msgbox(format("Post battle!"))
    release
}

text SlateportCity_Gym_Text_JoshPostDefeat{
    format("Good Luck!")
}

script SlateportCity_Gym_EventScript_Tommy {
    //setspeaker("Josh")
    trainerbattle_single(TRAINER_TOMMY, SlateportCity_Gym_Text_TommyIntro,SlateportCity_Gym_Text_TommyDefeat, SlateportCity_Gym_Text_TommyPostBattle, NO_MUSIC)
    setspeaker("Tommy")
    msgbox(format("Good Luck!"))
    waitmessage
    release
}

text SlateportCity_Gym_Text_TommyIntro{
    format("If you can't beat me, you won't stand a chance against Gulliver!")
}

text SlateportCity_Gym_Text_TommyDefeat{
    format("Wow! You've got some potential!")
}

script SlateportCity_Gym_Text_TommyPostBattle{
    setspeaker("Tommy")
    msgbox(format("Gulliver is stronger than me by several times. You'd better be on your guard!"))
    release
}

text SlateportCity_Gym_Text_TommyPostDefeat{
    format("Good Luck!")
}

