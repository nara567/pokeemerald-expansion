raw `
`
mapscripts LittlerootTown_PlayerHouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
    }
}

script LittlerootTown_PlayerHouse_2F_EventScript_PC {
    lockall
    call(LittlerootTown_BrendansHouse_2F_EventScript_CheckPlayersPC)
}

script LittlerootTown_PlayerHouse_2F_EventScript_WallClock {
    lockall
    checkplayergender
    if(var(VAR_RESULT) == MALE){
        setvar(VAR_0x8004, MALE)
    } else {
        setvar(VAR_0x8004, FEMALE)
    }
    call(LittlerootTown_PlayerHouse_2f_EventScript_SetClock)
}

script LittlerootTown_PlayerHouse_2f_EventScript_SetClock {
    if(flag(FLAG_SET_WALL_CLOCK)){
        call(PlayersHouse_2F_EventScript_CheckWallClock)
    }
    call(PlayersHouse_2F_EventScript_SetWallClock)
    delay(30)
    setvar(VAR_LITTLEROOT_INTRO_STATE,2)
    setflag(FLAG_SET_WALL_CLOCK)
    call(LittlerootTown_PlayerHouse_2f_EventScript_MomComesUpstairs)
    playse(SE_EXIT)
    removeobject(VAR_0x8008)
    releaseall
}

script LittlerootTown_PlayerHouse_2f_EventScript_MomComesUpstairs{
    setvar(VAR_0x8008, LOCALID_PLAYERS_HOUSE_2F_MOM)
    addobject(VAR_0x8008)
    applymovement(VAR_0x8008, PlayersHouse_2F_Movement_MomEntersMale)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    setspeaker(SP_NAME_MOM)
    msgbox(format("{PLAYER}, how do you like your clock?"))
    msgbox(format("Good! I know you're excited to start your adventure, but let's throw a party before you go!"))
    msgbox(format("And make sure you read the card on your desk!"))
    closemessage
    applymovement(VAR_0x8008, PlayersHouse_2F_Movement_MomExitsMale)
    waitmovement(0)
    return
}

