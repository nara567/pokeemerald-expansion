mapscripts LittlerootTown_PlayerHouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_SECRET_BASE_INITIALIZED,0)
        setvar(VAR_LITTLEROOT_INTRO_STATE,4)
        setvar(VAR_LITTLEROOT_INTRO_STATE,5)
        setflag(FLAG_RECEIVED_RUNNING_SHOES)
        setflag(FLAG_SYS_B_DASH)
    }
}

script LittlerootTown_PlayerHouse_2F_EventScript_PC {
    lockall
    call(LittlerootTown_BrendansHouse_2F_EventScript_CheckPlayersPC)
}

script LittlerootTown_PlayerHouse_2F_EventScript_WallClock {
    lockall
    checkplayergender
    if(var(VAR_RESULT) == MALE){
        setvar(VAR_0x8004, MALE)
    } else {
        setvar(VAR_0x8004, FEMALE)
    }
    call(LittlerootTown_PlayerHouse_2f_EventScript_SetClock)
}

script LittlerootTown_PlayerHouse_2f_EventScript_SetClock {
    if(flag(FLAG_SET_WALL_CLOCK)){
        call(PlayersHouse_2F_EventScript_CheckWallClock)
    }
    call(PlayersHouse_2F_EventScript_SetWallClock)
    delay(30)
    setvar(VAR_LITTLEROOT_INTRO_STATE,6)
    setflag(FLAG_SET_WALL_CLOCK)
    call(PlayersHouse_2F_EventScript_MomComesUpstairsMale)
    playse(SE_EXIT)
    removeobject(VAR_0x8008)
    releaseall
}