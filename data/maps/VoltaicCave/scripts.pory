raw`
VoltaicCave_MapScripts::
	//.byte 0
`

mapscripts VoltaticCave_MapScripts {
	MAP_SCRIPT_ON_RESUME{call(VoltaicCave_OnResume)}
	MAP_SCRIPT_ON_LOAD{call(VoltaicCave_OnLoad)}
	MAP_SCRIPT_ON_TRANSITION{call(VoltaicCave_OnTransition)}
}

script VoltaicCave_OnResume {
	if(flag(FLAG_SYS_CTRL_OBJ_DELETE)){
		call(VoltaicCave_EventScript_TryRemoveRegieleki)
	}
}

script VoltaicCave_OnLoad {
	if(flag(FLAG_SYS_REGIELEKI_PUZZLE_COMPLETED) == FALSE){
		call(VoltaicCave_EventScript_HideRegiEntrance)
	}
}

script VoltaicCave_OnTransition {
	if(!flag(FLAG_DEFEATED_REGIELEKI)){
		call(VoltaicCave_EventScript_ShowRegieleki)
	}
}

script VoltaicCave_EventScript_HideRegiEntrance {
	setmetatile(7, 19, METATILE_Cave_EntranceCover, TRUE)
	setmetatile(8, 19, METATILE_Cave_EntranceCover, TRUE)
	setmetatile(9, 19, METATILE_Cave_EntranceCover, TRUE)
	setmetatile(7, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
	setmetatile(8, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
	setmetatile(9, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
}

script VoltaicCave_EventScript_TryRemoveRegieleki {
	specialvar(VAR_RESULT, GetBattleOutcome)
	if(var(VAR_RESULT) != B_OUTCOME_CAUGHT){
		call(Common_EventScript_NopReturn)
	}
	removeobject(VAR_LAST_TALKED)
	return
}

script VoltaicCave_EventScript_ShowRegieleki {
	clearflag(FLAG_HIDE_REGIELEKI)
	return
}

script VoltaicCave_EventScript_CaveEntranceSide {
	lock
	braillemsgbox(VoltaicCave_Braille_SpeedAhead)
	release
}

script VoltaicCave_EventScript_CaveEntranceMiddle {
	lock
	if(flag(FLAG_SYS_REGIELEKI_PUZZLE_COMPLETED)){
		call(VoltaticCave_EventScript_BigHoleInWall)
	}
	braillemsgbox(VoltaicCave_Braille_SpeedAhead)
	release
}

script VoltaticCave_EventScript_BigHoleInWall {
	msgbox(gText_BigHoleInTheWall)
	release
}

script VoltaicCave_EventScript_AdamTrigger_Left {
	if(!flag(FLAG_HIDE_VOLTAIC_CAVE_ADAM)){
		lock
		applymovement(LOCALID_PLAYER, moves(
			walk_up * 2
			walk_right
			face_up
		))
		waitmovement(0)
		goto(VoltaicCave_EventScript_Adam)
	}
}

script VoltaicCave_EventScript_AdamTrigger_Right {
	if(!flag(FLAG_HIDE_VOLTAIC_CAVE_ADAM)){
		lock
		applymovement(LOCALID_PLAYER, moves(
			walk_up * 2
			walk_left
			face_up
		))
		waitmovement(0)
		goto(VoltaicCave_EventScript_Adam)
	}
}

script VoltaicCave_EventScript_AdamTrigger_Up {
	if(!flag(FLAG_HIDE_VOLTAIC_CAVE_ADAM)){
		lock
		applymovement(LOCALID_PLAYER, moves(
			walk_up
		))
		waitmovement(0)
		goto(VoltaicCave_EventScript_Adam)
	}
}

script VoltaicCave_EventScript_Adam {
	lock
	applymovement(LOCALID_ADAM, moves(
		jump_in_place_up
	))
	playmoncry(SPECIES_REGIELEKI, CRY_MODE_NORMAL)
	waitmoncry
	playse(SE_FAINT)
	waitse
	removeobject(LOCALID_REGIELEKI)
	setflag(FLAG_HIDE_REGIELEKI)
	waitmovement(0)
	setspeaker("Adam")
	msgbox(format("At last..."))
	msgbox(format("The power of this Tera Orb is just what we're looking for. Awakening Regigigas..."))
	playse(SE_PIN)
	applymovement(LOCALID_ADAM, moves(
		emote_exclamation_mark
		delay_8
		face_down
	))
	waitmovement(0)
	msgbox(format("It's you, from the museum. I guess Sierra needs more training."))
	msgbox(format("I've already gotten what I've come for. But why not give you a taste of power!"))
	trainerbattle_no_intro(TRAINER_ADAM_VOLTAIC_CAVE, VoltaicCave_Text_AdamLose)
	msgbox(format("It doesn't matter! Once we've collected the energy from the golems, Regigigas will be mine!"))
	applymovement(LOCALID_ADAM, moves(
		walk_down
		walk_down
		walk_down
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_8
		walk_left
	))
	waitmovement(LOCALID_ADAM)
	removeobject(LOCALID_ADAM)
	setflag(FLAG_HIDE_VOLTAIC_CAVE_ADAM)
	playse(SE_RG_DOOR)
	release
}

text VoltaicCave_Text_AdamLose {
	format("Fascinating.")
}